---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactSection from '../components/ContactSection.astro';
import { CATEGORIES } from '../data/categories';

const projects = await getCollection('projects', ({ data }) => !data.draft);

const tones = ['burgundy', 'blue', 'sand'];

const cards = CATEGORIES.map((category, index) => ({
  category,
  number: String(index + 1).padStart(2, '0'),
  tone: tones[index] ?? 'sand',
  anchor: category.title.toLowerCase().replace(/\s+/g, '-'),
  count: projects.filter((project) => project.data.category === category.slug).length,
}));
---

<BaseLayout>
  <section class="page-hero">
    <div class="container">
      <h1>Hi, I’m Nuda.</h1>
      <div class="hero-body">
        <p class="intro measure">
          I’m a Mathematics graduate from Universitas Negeri Semarang. This is a collection of my
          projects and experience in data analysis, data science, and machine learning.
        </p>
        <p class="links">
          <a class="text-link" href="/projects">View projects</a>
          <a class="text-link" href="/about">About me</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section container" aria-labelledby="projects-heading">
    <div class="section-head">
      <h2 id="projects-heading">Selected projects</h2>
      <a class="text-link" href="/projects">View all projects</a>
    </div>

    <div class="cards">
      {
        cards.map((card) => (
          <a class={`card-link tone-${card.tone}`} href={`/projects#${card.anchor}`}>
            <span class="number num">{card.number}</span>
            <h3>{card.category.title}</h3>
            <p class="desc">{card.category.description}</p>
            <span class="foot">
              <span>
                {card.count} {card.count === 1 ? 'project' : 'projects'}
              </span>
              <span class="arrow" aria-hidden="true">
                →
              </span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="about-band" aria-labelledby="about-heading">
    <div class="container rail">
      <h2 id="about-heading" class="rail-title">About me</h2>
      <div>
        <p class="measure body-text">
          I studied Mathematics at Universitas Negeri Semarang. My projects and internships have
          given me experience working with data in different contexts.
        </p>
        <p><a class="text-link" href="/about">More about me</a></p>
      </div>
    </div>
  </section>

  <ContactSection />
</BaseLayout>

<style>
  .hero-body {
    margin-top: var(--space-lg);
  }

  @media (min-width: 56rem) {
    .hero-body {
      margin-left: calc(var(--rail) + var(--space-lg));
    }
  }

  .intro {
    margin: 0;
    font-size: var(--text-lg);
    line-height: 1.55;
    color: var(--sand);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    margin: var(--space-md) 0 0;
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .section-head h2 {
    margin: 0;
    font-size: var(--text-2xl);
  }

  .cards {
    display: grid;
    gap: var(--space-md);
  }

  @media (min-width: 52rem) {
    .cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .card-link {
    display: flex;
    flex-direction: column;
    min-height: 17rem;
    padding: var(--space-md);
    color: var(--ink);
  }

  .card-link:hover {
    color: var(--ink);
  }

  .tone-blue {
    background: var(--blue);
  }

  .tone-sand {
    background: var(--sand);
  }

  .tone-burgundy {
    background: var(--burgundy);
    color: var(--cream);
  }

  .tone-burgundy:hover {
    color: var(--cream);
  }

  .number {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    opacity: 0.8;
  }

  h3 {
    margin: var(--space-md) 0 var(--space-xs);
    font-size: var(--text-2xl);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--transition);
  }

  .card-link:hover h3 {
    text-decoration-color: currentColor;
  }

  .desc {
    flex: 1;
    margin: 0 0 var(--space-md);
    opacity: 0.88;
  }

  .foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-top: var(--space-sm);
    border-top: 1px solid currentColor;
    font-size: 0.875rem;
  }

  .arrow {
    display: inline-block;
    transition: transform var(--transition);
  }

  .card-link:hover .arrow {
    transform: translateX(4px);
  }

  .about-band {
    padding-block: clamp(2.5rem, 6vw, 5rem);
    background: var(--sand);
  }

  .rail-title {
    margin: 0;
    font-size: var(--text-xl);
  }

  .body-text {
    margin-bottom: var(--space-md);
    font-size: var(--text-lg);
  }
</style>