---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { SITE } from '../data/site';

const featured = (
  await getCollection('projects', ({ data }) => data.featured && !data.draft)
).sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0));

const displayUrl = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '');

const contacts = [
  { label: 'Email', text: SITE.email, href: `mailto:${SITE.email}`, external: false },
  { label: 'LinkedIn', text: displayUrl(SITE.linkedin), href: SITE.linkedin, external: true },
  { label: 'GitHub', text: displayUrl(SITE.github), href: SITE.github, external: true },
];
---

<BaseLayout>
  <section class="container hero">
    <h1>Hi, I’m Nuda.</h1>
    <div class="hero-body">
      <p class="intro measure">
        I’m a Mathematics graduate from Universitas Negeri Semarang. This is a collection of my
        projects and experience in data analysis, data science, and machine learning.
      </p>
      <p class="links">
        <a class="text-link" href="/projects">View projects</a>
        <a class="text-link" href="/about">About me</a>
      </p>
    </div>
  </section>

  <section class="band" aria-labelledby="projects-heading">
    <div class="container rail">
      <h2 id="projects-heading" class="rail-title">Selected projects</h2>
      <div>
        <div class="list">
          {featured.map((project, i) => <ProjectCard project={project} index={i + 1} />)}
        </div>
        <p class="more"><a class="text-link" href="/projects">View all projects</a></p>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="about-heading">
    <div class="container rail">
      <h2 id="about-heading" class="rail-title">About me</h2>
      <div>
        <p class="measure body-text">
          I studied Mathematics at Universitas Negeri Semarang. My projects and internships have
          given me experience working with data in different contexts.
        </p>
        <p><a class="text-link" href="/about">More about me</a></p>
      </div>
    </div>
  </section>

  <section class="band" id="contact" aria-labelledby="contact-heading">
    <div class="container rail">
      <h2 id="contact-heading" class="rail-title">Contact</h2>
      <div>
        <p class="measure body-text">
          You can reach me by email or find me on LinkedIn and GitHub.
        </p>
        <ul class="contact-list">
          {
            contacts.map((item) => (
              <li>
                <span class="label">{item.label}</span>
                <a
                  href={item.href}
                  target={item.external ? '_blank' : undefined}
                  rel={item.external ? 'noopener noreferrer' : undefined}
                >
                  {item.text}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(3rem, 9vw, 7.5rem) clamp(2.5rem, 6vw, 5rem);
  }

  h1 {
    margin: 0 0 var(--space-lg);
    font-size: var(--text-hero);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .intro {
    margin: 0;
    font-size: var(--text-lg);
    line-height: 1.55;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    margin: var(--space-md) 0 0;
  }

  @media (min-width: 56rem) {
    .hero-body {
      margin-left: calc(var(--rail) + var(--space-lg));
    }
  }

  .rail-title {
    margin: 0;
    font-size: var(--text-xl);
  }

  .list {
    border-bottom: 1px solid var(--rule);
  }

  .more {
    margin: var(--space-md) 0 0;
  }

  .body-text {
    margin-bottom: var(--space-md);
    font-size: var(--text-lg);
  }

  .contact-list {
    max-width: 38rem;
    margin: var(--space-md) 0 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--rule);
  }

  .contact-list li {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: var(--space-sm);
    align-items: baseline;
    padding: 0.75rem 0;
    border-top: 1px solid var(--rule);
  }

  .contact-list a {
    overflow-wrap: anywhere;
  }
</style>