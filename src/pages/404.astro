---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you are looking for does not exist.">
  <section class="page-hero">
    <div class="container">
      <p class="label code">404</p>
      <h1>Page not found</h1>
      <p class="lead measure">The page you’re looking for doesn’t exist or may have moved.</p>
      <p class="links">
        <a class="text-link" href="/">Back to home</a>
        <a class="text-link" href="/projects">View projects</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .code {
    margin-bottom: var(--space-sm);
    color: var(--sand);
  }

  .lead {
    margin: var(--space-md) 0 0;
    font-size: var(--text-lg);
    color: var(--sand);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    margin: var(--space-md) 0 0;
  }
</style>