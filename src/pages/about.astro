---
import BaseLayout from '../layouts/BaseLayout.astro';
import Skills from '../components/Skills.astro';
import ContactSection from '../components/ContactSection.astro';
import { EDUCATION, EXPERIENCE, CERTIFICATIONS } from '../data/about';
---

<BaseLayout
  title="About"
  description="About Nuda: a Mathematics graduate from UNNES focused on data analytics, data science, and machine learning."
>
  <section class="section container intro">
    <p class="eyebrow">About</p>
    <h1>About Me</h1>
    <p class="lead">
      I’m Nurul Huda (Nuda), a Mathematics graduate from Universitas Negeri Semarang (UNNES),
      Indonesia. My mathematical background has shaped my analytical, problem-solving approach to
      data.
    </p>
    <p class="text">
      I’m interested in data analytics, data science, and machine learning, especially in
      applying statistical methods to uncover patterns and build predictive models. Through
      academic work, internships, and hands-on projects, I’ve gained practical experience across
      these areas.
    </p>
  </section>

  <section class="block container" aria-labelledby="education-heading">
    <h2 id="education-heading">Education</h2>
    <div class="card">
      <div class="row">
        <div>
          <h3>{EDUCATION.degree}</h3>
          <p class="org">{EDUCATION.school}, {EDUCATION.location}</p>
        </div>
        <p class="period">{EDUCATION.period}</p>
      </div>
      <p class="label">Relevant coursework</p>
      <ul class="chips">
        {EDUCATION.coursework.map((course) => <li>{course}</li>)}
      </ul>
      <p class="label">Final project</p>
      <p class="text small">{EDUCATION.finalProject}</p>
    </div>
  </section>

  <section class="block container" aria-labelledby="experience-heading">
    <h2 id="experience-heading">Experience</h2>
    <div class="stack">
      {
        EXPERIENCE.map((item) => (
          <article class="card">
            <div class="row">
              <div>
                <h3>{item.role}</h3>
                <p class="org">{item.organization}</p>
              </div>
              <p class="period">{item.period}</p>
            </div>
            <ul class="points">
              {item.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <Skills />

  <section class="block container" aria-labelledby="certs-heading">
    <h2 id="certs-heading">Certifications</h2>
    <ul class="chips">
      {CERTIFICATIONS.map((certification) => <li>{certification}</li>)}
    </ul>
  </section>

  <section class="block container" aria-labelledby="direction-heading">
    <h2 id="direction-heading">Interests &amp; Career Direction</h2>
    <p class="text">
      My goal is to grow as a data professional, working across data exploration, statistical
      analysis, business intelligence, and predictive modeling to turn complex data into clear,
      evidence-based insights.
    </p>
  </section>

  <ContactSection />
</BaseLayout>

<style>
  .intro h1 {
    font-size: var(--text-3xl);
  }

  .lead {
    max-width: 65ch;
    color: var(--text);
    font-size: var(--text-xl);
  }

  .text {
    max-width: 65ch;
    color: var(--text-muted);
    font-size: var(--text-lg);
  }

  .text.small {
    margin: 0;
    font-size: 1rem;
  }

  .block {
    padding-block: var(--space-lg);
  }

  .block h2 {
    margin-bottom: var(--space-md);
    font-size: var(--text-2xl);
  }

  .stack {
    display: grid;
    gap: var(--space-md);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-sm);
  }

  h3 {
    margin: 0;
    font-size: var(--text-xl);
  }

  .org {
    margin: 0;
    color: var(--text-muted);
  }

  .period {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--accent-cyan);
  }

  .label {
    margin: var(--space-md) 0 var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .chips li {
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: rgba(164, 138, 224, 0.08);
    font-size: var(--text-sm);
  }

  .points {
    margin: 0;
    padding-left: 1.25rem;
  }

  .points li {
    margin-bottom: 0.5rem;
    color: var(--text-muted);
  }
</style>