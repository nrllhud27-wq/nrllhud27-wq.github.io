---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SKILL_GROUPS } from '../data/skills';
import { EDUCATION, EXPERIENCE, CERTIFICATIONS } from '../data/about';
---

<BaseLayout
  title="About"
  description="About Nuda: a Mathematics graduate from UNNES with experience in data analysis, data science, and machine learning."
>
  <section class="page-hero">
    <div class="container">
      <h1>About me</h1>
      <p class="intro measure">
        I’m a Mathematics graduate from Universitas Negeri Semarang, Indonesia. My background
        includes coursework, projects, and internships involving mathematics, statistics, and data
        analysis.
      </p>
    </div>
  </section>

  <section class="block" aria-labelledby="education-heading">
    <div class="container rail">
      <h2 id="education-heading" class="rail-title">Education</h2>
      <div>
        <div class="row">
          <div>
            <h3>{EDUCATION.degree}</h3>
            <p class="org">{EDUCATION.school}, {EDUCATION.location}</p>
          </div>
          <p class="period">{EDUCATION.period}</p>
        </div>
        <p class="label sub">Relevant coursework</p>
        <p class="plain">{EDUCATION.coursework.join(' · ')}</p>
        <p class="label sub">Final project</p>
        <p class="plain">{EDUCATION.finalProject}</p>
      </div>
    </div>
  </section>

  <section class="block" aria-labelledby="experience-heading">
    <div class="container rail">
      <h2 id="experience-heading" class="rail-title">Experience</h2>
      <div>
        {
          EXPERIENCE.map((item) => (
            <article class="entry">
              <div class="row">
                <div>
                  <h3>{item.role}</h3>
                  <p class="org">{item.organization}</p>
                </div>
                <p class="period">{item.period}</p>
              </div>
              <ul class="points">
                {item.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="block sand" aria-labelledby="skills-heading">
    <div class="container rail">
      <h2 id="skills-heading" class="rail-title">Skills</h2>
      <ul class="skills">
        {
          SKILL_GROUPS.map((group) => (
            <li class="skill-row">
              <span class="label">{group.title}</span>
              <span>{group.items.join(' · ')}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="block" aria-labelledby="certs-heading">
    <div class="container rail">
      <h2 id="certs-heading" class="rail-title">Certifications</h2>
      <ul class="certs">
        {CERTIFICATIONS.map((certification) => <li>{certification}</li>)}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(2rem, 5vw, 3.5rem);
  }

  .intro {
    margin: var(--space-md) 0 0;
    font-size: var(--text-lg);
    line-height: 1.55;
    color: var(--sand);
  }

  .block {
    padding-block: clamp(2.25rem, 5vw, 4rem);
    border-top: 1px solid var(--rule);
  }

  .page-hero + .block {
    border-top: 0;
  }

  .block.sand {
    border-top: 0;
    background: var(--sand);
  }

  .rail-title {
    margin: 0;
    font-size: var(--text-xl);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem var(--space-md);
  }

  h3 {
    margin: 0;
    font-size: var(--text-xl);
  }

  .org {
    margin: 0.25rem 0 0;
    color: var(--muted);
  }

  .period {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--burgundy);
  }

  .sub {
    margin-top: var(--space-md);
  }

  .plain {
    max-width: 40rem;
    margin: 0.35rem 0 0;
  }

  .entry + .entry {
    margin-top: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--rule);
  }

  .points {
    max-width: 42rem;
    margin: var(--space-sm) 0 0;
    padding-left: 1.25rem;
  }

  .points li {
    margin-bottom: 0.5rem;
  }

  .skills,
  .certs {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--rule);
  }

  .skills {
    border-bottom-color: rgba(35, 31, 28, 0.3);
  }

  .skill-row {
    display: grid;
    gap: 0.25rem var(--space-md);
    padding: 0.85rem 0;
    border-top: 1px solid rgba(35, 31, 28, 0.3);
  }

  @media (min-width: 40rem) {
    .skill-row {
      grid-template-columns: 11rem 1fr;
    }
  }

  .certs li {
    padding: 0.85rem 0;
    border-top: 1px solid var(--rule);
  }
</style>