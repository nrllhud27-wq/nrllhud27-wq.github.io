---
import { SITE } from '../data/site';

const focusAreas = [
  'Mathematics Graduate',
  'Data Analytics',
  'Data Science',
  'Machine Learning',
];
---

<section class="hero">
  <div class="container hero-inner">
    <div class="hero-text">
      <p class="eyebrow">Data Portfolio</p>
      <h1>Turning Data Into <span class="gradient-text">Meaningful Insights.</span></h1>

      <p class="subtitle">
        {focusAreas.map((item) => <span>{item}</span>)}
      </p>

      <p class="intro">
        Hi, I’m Nuda. I enjoy exploring data, uncovering meaningful patterns, building
        analytical solutions, and developing machine learning models to solve real-world
        problems.
      </p>

      <div class="actions">
        <a class="btn btn-primary" href="/projects">View My Projects</a>
        <a class="btn btn-secondary" href="/about">About Me</a>
      </div>

      <ul class="social">
        <li>
          <a href={SITE.github} target="_blank" rel="noopener noreferrer">
            GitHub <span aria-hidden="true">↗</span>
          </a>
        </li>
        <li>
          <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer">
            LinkedIn <span aria-hidden="true">↗</span>
          </a>
        </li>
      </ul>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <svg viewBox="0 0 400 320" role="presentation" focusable="false">
        <defs>
          <linearGradient id="line-grad" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" style="stop-color: var(--accent-cyan)"></stop>
            <stop offset="50%" style="stop-color: var(--accent)"></stop>
            <stop offset="100%" style="stop-color: var(--accent-violet)"></stop>
          </linearGradient>
          <linearGradient id="area-grad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" style="stop-color: var(--accent); stop-opacity: 0.25"></stop>
            <stop offset="100%" style="stop-color: var(--accent); stop-opacity: 0"></stop>
          </linearGradient>
        </defs>

        <g class="grid">
          <line x1="20" y1="60" x2="380" y2="60"></line>
          <line x1="20" y1="120" x2="380" y2="120"></line>
          <line x1="20" y1="180" x2="380" y2="180"></line>
          <line x1="20" y1="240" x2="380" y2="240"></line>
          <line x1="20" y1="300" x2="380" y2="300"></line>
        </g>

        <path
          d="M20 250 L90 200 L150 215 L220 140 L290 160 L370 70 L370 300 L20 300 Z"
          fill="url(#area-grad)"></path>
        <polyline
          points="20,250 90,200 150,215 220,140 290,160 370,70"
          fill="none"
          stroke="url(#line-grad)"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"></polyline>

        <g class="nodes">
          <circle cx="20" cy="250" r="5"></circle>
          <circle cx="90" cy="200" r="5"></circle>
          <circle cx="150" cy="215" r="5"></circle>
          <circle cx="220" cy="140" r="5"></circle>
          <circle cx="290" cy="160" r="5"></circle>
          <circle cx="370" cy="70" r="5"></circle>
        </g>
      </svg>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .hero-inner {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  @media (min-width: 900px) {
    .hero-inner {
      grid-template-columns: 1.15fr 0.85fr;
    }
  }

  .hero-text {
    animation: fade-up 600ms ease both;
  }

  h1 {
    font-size: var(--text-hero);
    max-width: 14ch;
  }

  .subtitle {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .subtitle span + span::before {
    content: '|';
    margin-right: 0.75rem;
    color: var(--accent-violet);
  }

  .intro {
    max-width: 55ch;
    color: var(--text-muted);
    font-size: var(--text-lg);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }

  .social {
    display: flex;
    gap: var(--space-md);
    list-style: none;
    margin: var(--space-md) 0 0;
    padding: 0;
  }

  .social a {
    color: var(--text-muted);
    font-weight: 500;
  }

  .social a:hover {
    color: var(--text);
  }

  .hero-visual {
    padding: var(--space-md);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: linear-gradient(160deg, rgba(19, 26, 46, 0.9), rgba(10, 14, 26, 0.6));
    animation: fade-up 800ms ease both;
  }

  @media (max-width: 899px) {
    .hero-visual {
      display: none;
    }
  }

  .grid line {
    stroke: var(--border);
    stroke-width: 1;
    stroke-dasharray: 4 6;
  }

  .nodes circle {
    fill: var(--bg);
    stroke: var(--accent);
    stroke-width: 2;
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>