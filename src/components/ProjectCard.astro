---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { CATEGORIES } from '../data/categories';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, description, secondaryCategory, tools, status, thumbnail, thumbnailAlt } =
  project.data;

const labelFor = (slug: string) => CATEGORIES.find((c) => c.slug === slug)?.title ?? slug;
const notes = [
  ...(secondaryCategory ? [`Also ${labelFor(secondaryCategory)}`] : []),
  ...(status === 'in-progress' ? ['In progress'] : []),
];
---

<a class:list={['project', { 'no-image': !thumbnail }]} href={`/projects/${project.id}`}>
  {
    thumbnail && (
      <div class="thumb">
        <Image
          src={thumbnail}
          alt={thumbnailAlt ?? `Preview of ${title}`}
          width={720}
          loading="lazy"
        />
      </div>
    )
  }

  <div class="body">
    {notes.length > 0 && <p class="notes">{notes.join(' · ')}</p>}
    <h3>{title}</h3>
    <p class="desc">{description}</p>
    <p class="tools">{tools.join(' · ')}</p>
    <span class="more">View project details <span class="arrow" aria-hidden="true">→</span></span>
  </div>
</a>

<style>
  .project {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--rule);
    background: #faf5e9;
    color: var(--ink);
    transition: border-color var(--transition);
  }

  .project:hover {
    border-color: var(--burgundy);
    color: var(--ink);
  }

  /* Cards without an image get a thick top line in the category color */
  .no-image {
    border-top: 4px solid var(--tone, var(--burgundy));
  }

  .thumb {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    padding: 0.5rem;
    border-bottom: 1px solid var(--rule);
    background: rgba(229, 211, 175, 0.35);
  }

  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.5rem;
    padding: var(--space-md);
  }

  .notes {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--burgundy);
  }

  h3 {
    margin: 0;
    font-size: var(--text-xl);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--transition);
  }

  .project:hover h3 {
    text-decoration-color: var(--burgundy);
  }

  .desc {
    margin: 0;
    color: var(--muted);
  }

  .tools {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .more {
    margin-top: auto;
    padding-top: var(--space-xs);
    font-weight: 600;
    color: var(--burgundy);
  }

  .arrow {
    display: inline-block;
    transition: transform var(--transition);
  }

  .project:hover .arrow {
    transform: translateX(4px);
  }
</style>