---
import type { CollectionEntry } from 'astro:content';
import { CATEGORIES } from '../data/categories';

interface Props {
  project: CollectionEntry<'projects'>;
  index?: number;
}

const { project, index } = Astro.props;
const { title, description, category, secondaryCategory, tools, status } = project.data;

const labelFor = (slug: string) => CATEGORIES.find((c) => c.slug === slug)?.title ?? slug;
const number = index === undefined ? null : String(index).padStart(2, '0');
---

<a class:list={['row', { 'has-number': number }]} href={`/projects/${project.id}`}>
  {number && <span class="number num">{number}</span>}

  <div class="main">
    <h3>{title}</h3>
    <p class="desc">{description}</p>
    <p class="tools">{tools.join(' · ')}</p>
  </div>

  <div class="meta">
    <p class="category">{labelFor(category)}</p>
    {secondaryCategory && <p class="note">Also {labelFor(secondaryCategory)}</p>}
    {status === 'in-progress' && <p class="note">In progress</p>}
  </div>
</a>

<style>
  .row {
    display: grid;
    gap: var(--space-xs) var(--space-md);
    margin-inline: calc(var(--space-sm) * -1);
    padding: var(--space-md) var(--space-sm);
    border-top: 1px solid var(--rule);
    color: var(--ink);
    transition: background var(--transition);
  }

  @media (min-width: 48rem) {
    .row {
      grid-template-columns: minmax(0, 1fr) 10rem;
    }

    .row.has-number {
      grid-template-columns: 2.5rem minmax(0, 1fr) 10rem;
    }
  }

  .row:hover {
    background: rgba(229, 211, 175, 0.35);
    color: var(--ink);
  }

  .number {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    color: var(--muted);
  }

  h3 {
    margin: 0 0 0.35rem;
    font-size: var(--text-xl);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--transition);
  }

  .row:hover h3 {
    text-decoration-color: var(--burgundy);
  }

  .desc {
    max-width: 40rem;
    margin: 0 0 0.5rem;
    color: var(--muted);
  }

  .tools {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .category {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--burgundy);
  }

  .note {
    margin: 0.15rem 0 0;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  @media (min-width: 48rem) {
    .meta {
      text-align: right;
    }
  }
</style>