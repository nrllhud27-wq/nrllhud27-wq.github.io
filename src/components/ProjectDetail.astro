---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Breadcrumbs from './Breadcrumbs.astro';
import { CATEGORIES } from '../data/categories';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const {
  title,
  description,
  category,
  secondaryCategory,
  tools,
  status,
  thumbnail,
  thumbnailAlt,
  githubUrl,
  notebookUrl,
  dashboardUrl,
  metrics,
} = project.data;

const labelFor = (slug: string) => CATEGORIES.find((c) => c.slug === slug)?.title ?? slug;
const categories = [category, secondaryCategory].filter(Boolean) as string[];
const meta = [...categories.map(labelFor), ...(status === 'in-progress' ? ['In progress'] : [])];

const resources = [
  githubUrl && { label: 'GitHub repository', href: githubUrl },
  notebookUrl && { label: 'Jupyter notebook', href: notebookUrl },
  dashboardUrl && { label: 'Power BI dashboard', href: dashboardUrl },
].filter(Boolean) as { label: string; href: string }[];
---

<article>
  <header class="container head">
    <Breadcrumbs
      items={[{ label: 'Home', href: '/' }, { label: 'Projects', href: '/projects' }, { label: title }]}
    />
    <p class="label meta">{meta.join(' · ')}</p>
    <h1>{title}</h1>
    <p class="lead measure">{description}</p>
    {
      resources.length > 0 && (
        <p class="links">
          {resources.map((resource) => (
            <a class="text-link" href={resource.href} target="_blank" rel="noopener noreferrer">
              {resource.label}
            </a>
          ))}
        </p>
      )
    }
  </header>

  {
    thumbnail && (
      <div class="container">
        <figure class="shot">
          <Image src={thumbnail} alt={thumbnailAlt ?? `Preview of ${title}`} width={1200} />
        </figure>
      </div>
    )
  }

  {
    metrics.length > 0 && (
      <section class="band" aria-labelledby="metrics-heading">
        <div class="container rail">
          <h2 id="metrics-heading" class="rail-title">
            Key metrics
          </h2>
          <dl class="facts">
            {metrics.map((metric) => (
              <div>
                <dt>{metric.label}</dt>
                <dd class="num">{metric.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    )
  }

  <section class="band" aria-labelledby="tools-heading">
    <div class="container rail">
      <h2 id="tools-heading" class="rail-title">Tools &amp; technologies</h2>
      <p class="tools">{tools.join(' · ')}</p>
    </div>
  </section>

  <section class="band">
    <div class="container">
      <div class="prose">
        <slot />
      </div>
      <p class="back"><a href="/projects">Back to projects</a></p>
    </div>
  </section>
</article>

<style>
  .head {
    padding-block: var(--space-lg) clamp(1.5rem, 4vw, 2.5rem);
  }

  .meta {
    margin-bottom: var(--space-sm);
    color: var(--burgundy);
  }

  h1 {
    max-width: 22ch;
    margin: 0 0 var(--space-md);
    font-size: clamp(2rem, 1.3rem + 2.8vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  .lead {
    margin-bottom: var(--space-md);
    font-size: var(--text-lg);
    color: var(--muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    margin: 0;
  }

  .shot {
    max-width: 60rem;
    margin: 0 0 var(--space-xl);
    padding: 0.5rem;
    border: 1px solid var(--rule);
    background: rgba(229, 211, 175, 0.35);
  }

  .shot :global(img) {
    width: 100%;
    height: auto;
  }

  .rail-title {
    margin: 0;
    font-size: var(--text-xl);
  }

  .facts {
    max-width: 38rem;
    margin: 0;
    border-bottom: 1px solid var(--rule);
  }

  .facts div {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-sm);
    align-items: baseline;
    padding: 0.75rem 0;
    border-top: 1px solid var(--rule);
  }

  .facts dt {
    color: var(--muted);
  }

  .facts dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    text-align: right;
  }

  .tools {
    max-width: 38rem;
    margin: 0;
    font-size: var(--text-lg);
  }

  .prose {
    max-width: 40rem;
  }

  @media (min-width: 56rem) {
    .prose,
    .back {
      margin-left: calc(var(--rail) + var(--space-lg));
    }
  }

  .prose :global(h2) {
    margin: var(--space-xl) 0 var(--space-sm);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--rule);
    font-size: var(--text-2xl);
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .prose :global(h3) {
    margin: var(--space-lg) 0 var(--space-xs);
    font-size: var(--text-xl);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 var(--space-sm);
    padding-left: 1.25rem;
  }

  .prose :global(li) {
    margin-bottom: 0.4rem;
  }

  .prose :global(a) {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .prose :global(code) {
    padding: 0.1rem 0.3rem;
    background: rgba(229, 211, 175, 0.5);
    font-size: 0.9em;
  }

  .prose :global(img) {
    height: auto;
    margin-block: var(--space-md) var(--space-xs);
    padding: 0.5rem;
    border: 1px solid var(--rule);
    background: rgba(229, 211, 175, 0.35);
  }

  .prose :global(p > em:only-child) {
    display: block;
    margin-bottom: var(--space-md);
    font-size: 0.875rem;
    font-style: normal;
    color: var(--muted);
  }

  .back {
    margin: var(--space-xl) 0 0;
  }

  .back a::before {
    content: '\2190';
    margin-right: 0.4em;
  }
</style>