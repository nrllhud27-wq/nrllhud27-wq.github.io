---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Breadcrumbs from './Breadcrumbs.astro';
import { CATEGORIES } from '../data/categories';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const {
  title,
  description,
  category,
  secondaryCategory,
  tools,
  status,
  thumbnail,
  thumbnailAlt,
  githubUrl,
  notebookUrl,
  dashboardUrl,
  metrics,
} = project.data;

const labelFor = (slug: string) => CATEGORIES.find((c) => c.slug === slug)?.title ?? slug;
const categorySlugs = [category, secondaryCategory].filter(Boolean) as string[];

const resources = [
  githubUrl && { label: 'GitHub Repository', href: githubUrl },
  notebookUrl && { label: 'Jupyter Notebook', href: notebookUrl },
  dashboardUrl && { label: 'Power BI Dashboard', href: dashboardUrl },
].filter(Boolean) as { label: string; href: string }[];
---

<article class="section container">
  <Breadcrumbs
    items={[{ label: 'Home', href: '/' }, { label: 'Projects', href: '/projects' }, { label: title }]}
  />

  <header class="head">
    <div class="meta">
      {
        categorySlugs.map((slug) => (
          <a class="badge" href={`/projects/${slug}`}>
            {labelFor(slug)}
          </a>
        ))
      }
      {status === 'in-progress' && <span class="badge badge-progress">In Progress</span>}
    </div>

    <h1>{title}</h1>
    <p class="lead">{description}</p>

    {
      resources.length > 0 && (
        <div class="actions">
          {resources.map((resource, index) => (
            <a
              class={`btn ${index === 0 ? 'btn-primary' : 'btn-secondary'}`}
              href={resource.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              {resource.label} <span aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      )
    }
  </header>

  {
    thumbnail && (
      <figure class="shot">
        <Image src={thumbnail} alt={thumbnailAlt ?? `Preview of ${title}`} width={1000} />
      </figure>
    )
  }

  {
    metrics.length > 0 && (
      <section class="block" aria-labelledby="metrics-heading">
        <h2 id="metrics-heading">Key Metrics</h2>
        <dl class="metrics">
          {metrics.map((metric) => (
            <div class="metric card">
              <dt>{metric.label}</dt>
              <dd>{metric.value}</dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }

  <section class="block" aria-labelledby="tools-heading">
    <h2 id="tools-heading">Tools &amp; Technologies</h2>
    <ul class="tools">
      {tools.map((tool) => <li>{tool}</li>)}
    </ul>
  </section>

  <div class="prose">
    <slot />
  </div>

  <a class="back" href="/projects">← Back to all projects</a>
</article>

<style>
  .head {
    max-width: 820px;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: var(--space-sm);
  }

  .badge {
    padding: 0.15rem 0.65rem;
    border-radius: 999px;
    background: rgba(164, 138, 224, 0.12);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }

  .badge:hover {
    color: var(--accent-cyan);
  }

  .badge-progress {
    background: rgba(144, 113, 206, 0.16);
    color: var(--accent-violet);
  }

  h1 {
    font-size: var(--text-3xl);
  }

  .lead {
    color: var(--text-muted);
    font-size: var(--text-lg);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }

  .shot {
    max-width: 980px;
    margin: var(--space-lg) 0;
    padding: 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: linear-gradient(160deg, #2a2150, #17122f);
  }

  .shot :global(img) {
    width: 100%;
    height: auto;
    border-radius: 8px;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.45);
  }

  .block {
    margin-top: var(--space-lg);
  }

  .block h2 {
    font-size: var(--text-xl);
  }

  .metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: var(--space-sm);
    margin: 0;
  }

  .metric {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.25rem;
  }

  .metric dt {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .metric dd {
    margin: 0;
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--text);
  }

  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tools li {
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: rgba(164, 138, 224, 0.08);
    font-size: var(--text-sm);
  }

  .prose {
    max-width: 760px;
    margin-top: var(--space-lg);
  }

  .prose :global(h2) {
    margin: var(--space-xl) 0 var(--space-sm);
    font-size: var(--text-2xl);
  }

  .prose :global(h3) {
    margin: var(--space-lg) 0 var(--space-xs);
    font-size: var(--text-xl);
  }

  .prose :global(p),
  .prose :global(li) {
    color: var(--text-muted);
    font-size: var(--text-lg);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 var(--space-sm);
    padding-left: 1.25rem;
  }

  .prose :global(li) {
    margin-bottom: 0.4rem;
  }

  .prose :global(strong) {
    color: var(--text);
  }

  .prose :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose :global(code) {
    padding: 0.1rem 0.35rem;
    border-radius: 6px;
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  .prose :global(img) {
    margin-block: var(--space-md);
    border-radius: 10px;
  }

  .back {
    display: inline-block;
    margin-top: var(--space-xl);
    font-weight: 600;
  }
</style>