---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Breadcrumbs from './Breadcrumbs.astro';
import { CATEGORIES } from '../data/categories';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const {
  title,
  description,
  category,
  secondaryCategory,
  tools,
  status,
  thumbnail,
  thumbnailAlt,
  githubUrl,
  notebookUrl,
  dashboardUrl,
  metrics,
} = project.data;

const labelFor = (slug: string) => CATEGORIES.find((c) => c.slug === slug)?.title ?? slug;
const categories = [category, secondaryCategory].filter(Boolean) as string[];
const meta = [...categories.map(labelFor), ...(status === 'in-progress' ? ['In progress'] : [])];

const resources = [
  githubUrl && { label: 'GitHub repository', href: githubUrl },
  notebookUrl && { label: 'Jupyter notebook', href: notebookUrl },
  dashboardUrl && { label: 'Power BI dashboard', href: dashboardUrl },
].filter(Boolean) as { label: string; href: string }[];
---

<article>
  <header class="detail-hero">
    <div class="container">
      <Breadcrumbs
        items={[{ label: 'Home', href: '/' }, { label: 'Projects', href: '/projects' }, { label: title }]}
      />
      <p class="label meta">{meta.join(' · ')}</p>
      <h1>{title}</h1>
      <p class="lead measure">{description}</p>
      {
        resources.length > 0 && (
          <p class="links">
            {resources.map((resource) => (
              <a class="text-link" href={resource.href} target="_blank" rel="noopener noreferrer">
                {resource.label}
              </a>
            ))}
          </p>
        )
      }
    </div>
  </header>

  {
    thumbnail && (
      <div class="container">
        <figure class="shot">
          <Image src={thumbnail} alt={thumbnailAlt ?? `Preview of ${title}`} width={1200} />
        </figure>
      </div>
    )
  }

  {
    metrics.length > 0 && (
      <section class="container block" aria-labelledby="metrics-heading">
        <h2 id="metrics-heading" class="block-title">
          Key metrics
        </h2>
        <dl class="metrics">
          {metrics.map((metric) => (
            <div class="metric">
              <dt>{metric.label}</dt>
              <dd class="num">{metric.value}</dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }

  <section class="container block" aria-labelledby="tools-heading">
    <h2 id="tools-heading" class="block-title">Tools &amp; technologies</h2>
    <p class="tools">{tools.join(' · ')}</p>
  </section>

  <section class="container block">
    <div class="prose">
      <slot />
    </div>
    <p class="back"><a href="/projects">Back to projects</a></p>
  </section>
</article>

<style>
  .detail-hero {
    padding-block: var(--space-lg) clamp(2rem, 5vw, 3.5rem);
    background: var(--burgundy);
    color: var(--cream);
    /* Breadcrumbs read these two colors, so they adapt to the dark background */
    --muted: var(--sand);
    --ink: var(--cream);
  }

  .detail-hero :focus-visible {
    outline-color: var(--blue);
  }

  .meta {
    margin-bottom: var(--space-sm);
    color: var(--sand);
  }

  h1 {
    max-width: 22ch;
    margin: 0 0 var(--space-md);
    font-size: clamp(2rem, 1.3rem + 2.8vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--cream);
  }

  .lead {
    margin-bottom: var(--space-md);
    font-size: var(--text-lg);
    color: var(--sand);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    margin: 0;
  }

  .links a {
    color: var(--blue);
  }

  .links a:hover {
    color: var(--cream);
  }

  .shot {
    max-width: 60rem;
    margin: var(--space-lg) 0 0;
    padding: 0.5rem;
    background: var(--sand);
  }

  .shot :global(img) {
    width: 100%;
    height: auto;
  }

  .block {
    margin-top: var(--space-xl);
  }

  .block-title {
    margin: 0 0 var(--space-sm);
    font-size: var(--text-xl);
  }

  .metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--space-md);
    margin: 0;
    padding: var(--space-md);
    background: var(--sand);
  }

  .metric {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.25rem;
  }

  .metric dt {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .metric dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    line-height: 1.1;
  }

  .tools {
    margin: 0;
    padding: var(--space-md);
    background: var(--blue);
    font-size: var(--text-lg);
  }

  .prose {
    max-width: 42rem;
  }

  .prose :global(h2) {
    margin: var(--space-xl) 0 var(--space-sm);
    padding-top: var(--space-sm);
    border-top: 2px solid var(--burgundy);
    font-size: var(--text-2xl);
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(h3) {
    margin: var(--space-lg) 0 var(--space-xs);
    font-size: var(--text-xl);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 var(--space-sm);
    padding-left: 1.25rem;
  }

  .prose :global(li) {
    margin-bottom: 0.4rem;
  }

  .prose :global(a) {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .prose :global(code) {
    padding: 0.1rem 0.3rem;
    background: rgba(229, 211, 175, 0.6);
    font-size: 0.9em;
  }

  .prose :global(img) {
    height: auto;
    margin-block: var(--space-md) var(--space-xs);
    padding: 0.5rem;
    background: var(--sand);
  }

  .prose :global(p > em:only-child) {
    display: block;
    margin-bottom: var(--space-md);
    font-size: 0.875rem;
    font-style: normal;
    color: var(--muted);
  }

  .back {
    margin: var(--space-xl) 0 0;
    font-weight: 600;
  }

  .back a::before {
    content: '\2190';
    margin-right: 0.4em;
  }
</style>