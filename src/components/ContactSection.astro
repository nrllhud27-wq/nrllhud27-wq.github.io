---
import { SITE } from '../data/site';
---

<section class="section container" id="contact" aria-labelledby="contact-heading">
  <div class="box">
    <h2 id="contact-heading">Contact</h2>
    <p class="text measure">You can reach me by email or find me on LinkedIn and GitHub.</p>
    <div class="actions">
      <a class="button solid" href={`mailto:${SITE.email}`}>Email</a>
      <a class="button" href={SITE.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a class="button" href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub</a>
    </div>
  </div>
</section>

<style>
  .box {
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid var(--rule);
    background: #faf5e9;
  }

  h2 {
    margin: 0 0 var(--space-sm);
    font-size: var(--text-3xl);
  }

  .text {
    margin-bottom: var(--space-md);
    font-size: var(--text-lg);
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .button {
    display: inline-block;
    padding: 0.75rem 1.4rem;
    border: 1px solid var(--burgundy);
    font-weight: 600;
    color: var(--burgundy);
    transition:
      background var(--transition),
      color var(--transition),
      border-color var(--transition);
  }

  .button:hover {
    background: var(--burgundy);
    color: var(--cream);
  }

  .solid {
    background: var(--burgundy);
    color: var(--cream);
  }

  .solid:hover {
    border-color: var(--ink);
    background: var(--ink);
  }
</style>