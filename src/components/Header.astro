---
const { pathname } = Astro.url;

const links = [
  { label: 'Projects', href: '/projects', match: '/projects' },
  { label: 'About', href: '/about', match: '/about' },
  { label: 'Contact', href: '/#contact', match: null },
];

const isCurrent = (match: string | null) => match !== null && pathname.startsWith(match);
---

<header class="site-header">
  <div class="container bar">
    <a class="wordmark" href="/">Nuda</a>
    <nav aria-label="Primary">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={isCurrent(link.match) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--ink);
  }

  .bar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-block: 1.25rem;
  }

  .wordmark {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .wordmark:hover {
    color: var(--burgundy);
  }

  ul {
    display: flex;
    gap: clamp(0.875rem, 3vw, 2rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    padding-block: 0.25rem;
    border-bottom: 1px solid transparent;
    font-size: 0.95rem;
    color: var(--ink);
    transition:
      border-color var(--transition),
      color var(--transition);
  }

  nav a:hover,
  nav a[aria-current='page'] {
    border-bottom-color: var(--burgundy);
    color: var(--burgundy);
  }
</style>